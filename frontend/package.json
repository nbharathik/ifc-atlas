{
  "name": "ifc-atlas",
  "private": true,
  "version": "1.0.0",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbharathik/ifc-atlas.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode webdemo",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode webdemo",
    "preview": "vite preview",
    "preview:web": "vite preview --mode webdemo",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri:dev": "cd .. && npm run tauri -- dev",
    "tauri:build": "cross-env VITE_PLATFORM=tauri tsc -b && cross-env VITE_PLATFORM=tauri vite build"
  },
  "dependencies": {
    "@thatopen/components": "^3.4.0",
    "@thatopen/components-front": "^3.4.2",
    "@thatopen/fragments": "^3.4.0",
    "camera-controls": "^3.1.2",
    "ifc-atlas-desktop": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "three": "^0.182.0",
    "three-mesh-bvh": "0.9.9",
    "web-ifc": "^0.0.77",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.6.2",
    "vite": "^6.4.2",
    "vitest": "^2.1.8"
  }
}
