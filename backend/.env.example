# IFC Atlas backend - environment overrides.
#
# Copy the variables you need into ~/.ifc-atlas/.env (loaded at boot) or set
# them in your shell. The backend never reads a .env file from the repo.
# Every variable is optional - the defaults work out of the box.

# ── LLM provider keys ────────────────────────────────────────────────────────
# Preferred: configure keys in-app (Chat Manager → Settings → AI keys); they
# are stored in ~/.ifc-atlas/secrets.json. Env vars take precedence when set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
# Set 1 for DEBUG logs + per-request timing (same as `python run.py --verbose`).
BACKEND_VERBOSE=0

# ── Storage ──────────────────────────────────────────────────────────────────
# All writable state lives in the per-user dotfolder (~/.ifc-atlas). Override
# the root, or re-point individual dirs (absolute paths).
#IFC_ATLAS_HOME=
#UPLOAD_DIR=
#SNAPSHOT_DIR=
#DATA_DIR=
#CHECKPOINT_DIR=
#FRAGMENT_CACHE_DIR=

# Uploads-dir LRU cap in bytes (0 = unlimited). Default 2 GiB.
#IFC_VIEWER_CACHE_MAX_BYTES=2147483648
# Per-request IFC upload cap in bytes (0 = unlimited). Default 512 MiB.
#IFC_VIEWER_MAX_UPLOAD_BYTES=536870912

# ── MCP server (viewer-as-server, /mcp/sse) ──────────────────────────────────
# Bearer token required by external MCP clients. Unset = no auth (loopback dev).
#MCP_SERVER_TOKEN=
# Set 1 to expose the write-tier MCP tools (edits). Off by default.
#MCP_ALLOW_WRITES=0

# ── Feature flags ────────────────────────────────────────────────────────────
# Chat "Edit" surface (write tools). Must flip together with the frontend flag
# in frontend/src/config/featureFlags.ts - see app/core/config.py.
#EDIT_MODE_ENABLED=0
