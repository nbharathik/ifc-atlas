# IFC Atlas backend - environment overrides.
#
# Copy the variables you need into ~/.ifc-atlas/.env (loaded at boot) or set
# them in your shell. The backend never reads a .env file from the repo.
# The loopback-local defaults work out of the box. Shared-server mode requires
# an explicit strong access token.

# ── LLM provider keys ────────────────────────────────────────────────────────
# Preferred: configure keys in-app (Chat Manager → Settings → AI keys); they
# are stored in ~/.ifc-atlas/secrets.json. Env vars take precedence when set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# Loopback is the safe default for local development and desktop. Containers
# set 0.0.0.0 explicitly.
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
# Set 1 for DEBUG logs + per-request timing (same as `python run.py --verbose`).
BACKEND_VERBOSE=0

# Explicit deployment profile: local | server.
# - local: loopback without a token is allowed; Tauri injects a random token.
# - server: IFC_ATLAS_API_TOKEN is mandatory and protects REST + WebSockets.
IFC_ATLAS_SECURITY_MODE=local
# Generate a random value with at least 32 characters. Never commit a real one.
#IFC_ATLAS_API_TOKEN=
# Free-form Python/plugin code is enabled by default only in local mode.
# Do not enable this on a shared server until an OS/process sandbox is deployed.
#IFC_ATLAS_ENABLE_CODE_EXECUTION=0

# ── Storage ──────────────────────────────────────────────────────────────────
# All writable state lives in the per-user dotfolder (~/.ifc-atlas). Override
# the root, or re-point individual dirs (absolute paths).
#IFC_ATLAS_HOME=
#UPLOAD_DIR=
#SNAPSHOT_DIR=
#DATA_DIR=
#CHECKPOINT_DIR=
#FRAGMENT_CACHE_DIR=

# Uploads-dir LRU cap in bytes (0 = unlimited). Default 2 GiB.
#IFC_VIEWER_CACHE_MAX_BYTES=2147483648
# Per-request IFC upload cap in bytes (0 = unlimited). Default 512 MiB.
#IFC_VIEWER_MAX_UPLOAD_BYTES=536870912
# Maximum sidecar conversion read/write inactivity in seconds. Never unlimited.
#SIDECAR_CONVERT_TIMEOUT_S=900

# ── MCP server (viewer-as-server, /mcp/sse) ──────────────────────────────────
# Bearer token required by external MCP clients. Unset = no auth (loopback dev).
#MCP_SERVER_TOKEN=
# Set 1 to expose the write-tier MCP tools (edits). Off by default.
#MCP_ALLOW_WRITES=0

# ── Feature flags ────────────────────────────────────────────────────────────
# Chat "Edit" surface (write tools). Must flip together with the frontend flag
# in frontend/src/config/featureFlags.ts - see app/core/config.py.
#EDIT_MODE_ENABLED=0
